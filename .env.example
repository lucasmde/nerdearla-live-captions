# Required for the Gemini engine (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# gemini (default when the key is set) | mock (no key, scripted demo)
ENGINE=gemini
# Streaming speech-to-text model and text model for translation
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSLATE_MODEL=gemini-3.5-flash-lite
# Fallback text models tried when the primary is rate limited (comma separated)
TRANSLATE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest
# gemini | ollama (local Gemma) | none
TRANSLATOR=gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Shared secret required by /ws/ingest and the operator console. Leave empty only for local dev.
INGEST_TOKEN=change-me
# Translate long partial hypotheses too (1 = yes, lower perceived latency, more API calls)
TRANSLATE_PARTIALS=1
# Minimum interval between partial translations per session (ms)
PARTIAL_TRANSLATE_EVERY_MS=2500
PORT=8080

# ---------- v2: identidad, chat y mail ----------
# Sign in with Google: creá un "ID de cliente OAuth" (aplicación web) en https://console.cloud.google.com/apis/credentials
# con tu dominio (y http://localhost:8080 para pruebas) en "Orígenes autorizados de JavaScript".
GITHUB_CLIENT_ID=            # opcional: "Entrar con GitHub" (OAuth App; callback <PUBLIC_URL>/api/auth/github/callback)
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
# Secreto para firmar la cookie de sesión (cualquier string largo; si está vacío se genera uno al arrancar)
SESSION_SECRET=
# 1 = se puede entrar sólo con un nombre (sin cuenta). 0 = obligatorio iniciar sesión con Google.
ALLOW_GUESTS=1
# Quiénes pueden transmitir como expositor (mails separados por coma). Vacío = cualquiera con sesión iniciada.
SPEAKER_EMAILS=
# Restringir el inicio de sesión a estos dominios de mail (coma). Vacío = cualquiera.
ALLOWED_DOMAINS=
# URL pública (para los links en los mails)
PUBLIC_URL=
# Envío de transcripciones por mail: SMTP (Gmail: smtps://usuario%40gmail.com:contraseña-de-aplicacion@smtp.gmail.com:465) o Resend
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM="Live Captions <captions@tu-dominio.org>"
